{
  "name": "mcp-postgres-server",
  "version": "0.2.0",
  "description": "A Model Context Protocol server for PostgreSQL database operations",
  "type": "module",
  "mcpName": "io.github.antonorlov/mcp-postgres-server",
  "bin": {
    "mcp-postgres": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "postgresql",
    "database",
    "claude",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pg": "^8.23.0",
    "pg-connection-string": "^2.14.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.10.7",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonorlov/mcp-postgres-server.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "ssh2": "^1.17.0"
  }
}
